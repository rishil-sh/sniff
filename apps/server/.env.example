# Copy to .env (pnpm bootstrap does this and fills in BETTER_AUTH_SECRET). Validated in src/env.server.ts.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
DATABASE_URL=file:../../.data/local.db
MASTRA_DATABASE_URL=file:../../.data/mastra.db
DETECTOR_URL=http://localhost:7860

# Optional: Muse (Meta Model API) writes the friendly replies; without it the detector's template text is used.
MODEL_API_KEY=
# MUSE_MODEL=muse-wonder-1.0

# Optional: emails that may see WhatsApp checks in the web History (comma-separated)
ADMIN_EMAILS=

# Optional: WhatsApp Cloud API. Leave empty to disable the channel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
