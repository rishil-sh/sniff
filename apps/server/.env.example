# Sniff API server (local development). `pnpm bootstrap` copies this to .env and fills in BETTER_AUTH_SECRET.
# Validated at startup by src/env.server.ts; an invalid value stops the server with a clear message.
# Docker users: don't edit this file, use the root .env (see ../../.env.example). Never commit .env.

# ── Required (the defaults work as-is for localhost) ──────────────────────────────────────────────────────────────
# Signs login sessions. 32+ characters. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of this server (auth callbacks and cookies are issued for it).
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the web app. The only origin allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:3001
# Production with web and API on separate hosts: their shared parent domain (e.g. example.com). Leave unset locally.
# COOKIE_DOMAIN=
# SQLite file for accounts and check history (relative to apps/server). Apply migrations with `pnpm db:migrate`.
DATABASE_URL=file:../../.data/local.db
# SQLite file for the reply agent's conversation memory. Kept apart so it can be wiped without losing history.
MASTRA_DATABASE_URL=file:../../.data/mastra.db
# Where the Python detector listens (`pnpm dev` starts it on :7860).
DETECTOR_URL=http://localhost:7860

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────────────────────
# Muse (Meta Model API) key, from https://dev.meta.ai. Writes the friendly replies and answers follow-ups.
# Empty: verdicts are unchanged, replies use the detector's template text.
MODEL_API_KEY=
# Default: muse-wonder-1.0. muse-spark-1.3 is faster and cheaper.
# MUSE_MODEL=muse-wonder-1.0

# Comma-separated emails allowed to see WhatsApp checks in the web History.
ADMIN_EMAILS=

# WhatsApp Cloud API. Leave all four empty to disable the channel. Where to find each: ../../.env.example.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
