# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Python detector (apps/detector), FastAPI
# @type=url
DETECTOR_URL=http://localhost:7860

# Separate SQLite file for Mastra memory, so drizzle-kit never sees its tables
# @type=string(minLength=1)
MASTRA_DATABASE_URL=file:../../.data/mastra.db

# Meta Model API (Muse) key; without it replies fall back to the detector's template message
# @optional
MODEL_API_KEY=

# @optional @sensitive=false
MUSE_MODEL=muse-wonder-1.0

# --- WhatsApp Cloud API (single Sniff number). Leave empty to disable the channel. ---
# @optional
WHATSAPP_ACCESS_TOKEN=
# @optional @sensitive=false
WHATSAPP_PHONE_NUMBER_ID=
# @optional
WHATSAPP_APP_SECRET=
# @optional
WHATSAPP_VERIFY_TOKEN=

# Comma-separated emails that may see WhatsApp checks in the web history
# @optional @sensitive=false
ADMIN_EMAILS=
