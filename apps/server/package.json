{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build ./src/index.ts --compile --bytecode --format=esm --minify --no-compile-autoload-dotenv --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "auth:generate": "bunx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "bun test"
  },
  "dependencies": {
    "@mastra/core": "^1.81.0",
    "@mastra/libsql": "^1.28.0",
    "@mastra/memory": "^1.40.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sniff/api": "workspace:*",
    "@sniff/auth": "workspace:*",
    "@sniff/db": "workspace:*",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.13.7",
    "libsql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sniff/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
