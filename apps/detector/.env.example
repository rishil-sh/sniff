# Copy to .env and fill in. Never commit .env.
# Meta Model API (standard tier, not -contributor): https://dev.meta.ai
MODEL_API_KEY=

# Hugging Face token with access to gated models: https://huggingface.co/settings/tokens
HF_TOKEN=

# Text detector model pair (base + Instruct, same tokenizer). Default: Llama-3.1-8B (~32 GB bf16).
# On a 24 GB Mac use the ungated bf16 mirrors of the 3B pair:
# AI_DETECTOR_TEXT_OBSERVER=mlx-community/Llama-3.2-3B-bf16
# AI_DETECTOR_TEXT_PERFORMER=mlx-community/Llama-3.2-3B-Instruct
