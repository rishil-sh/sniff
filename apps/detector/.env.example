# Copy to .env (pnpm bootstrap does this). Never commit .env. Every value is optional.

# Meta Model API (Muse), only used when the detector is asked to explain or transcribe: https://dev.meta.ai
MODEL_API_KEY=

# Hugging Face token. Not needed for the defaults; only for gated models such as meta-llama/Llama-3.1-8B.
HF_TOKEN=

# Text zero-shot pair (base + Instruct, same tokenizer). Weight 0: supporting evidence only, never decides a verdict.
# Default: ungated mlx-community/Llama-3.2-3B-bf16 + mlx-community/Llama-3.2-3B-Instruct (~13 GB download and RAM).
# AI_DETECTOR_TEXT_OBSERVER=mlx-community/Llama-3.2-3B-bf16
# AI_DETECTOR_TEXT_PERFORMER=mlx-community/Llama-3.2-3B-Instruct
# Set to 0 to skip the pair (no download, no RAM).
# AI_DETECTOR_TEXT_PAIR=0

# Where models are downloaded (default: apps/detector/data/models).
# AI_DETECTOR_CACHE=
