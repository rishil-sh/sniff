# Sniff detector (Python, local development). `pnpm bootstrap` copies this to .env. Every value is optional.
# Docker users: set these in the root .env instead. Never commit .env.

# ── Meta Model API (Muse) ─────────────────────────────────────────────────────────────────────────────────────────
# Only used when the detector itself is called with `send_to_muse: true` (one-line explanation, voice transcript).
# Inside Sniff the server writes replies and sends `send_to_muse: false`, so this is for standalone detector use.
# Get: https://dev.meta.ai
MODEL_API_KEY=
# Model for those explanations. Default: muse-wonder-1.0. muse-spark-1.3 is faster and cheaper.
# AI_DETECTOR_REPORT_MODEL=muse-wonder-1.0

# ── Hugging Face ──────────────────────────────────────────────────────────────────────────────────────────────────
# Not needed for the defaults (all ungated); only for gated models such as meta-llama/Llama-3.1-8B.
# Get: https://huggingface.co/settings/tokens (read access is enough; accept the model's license on its page first).
HF_TOKEN=

# ── Text zero-shot pair (Binoculars / Fast-DetectGPT / GLTR) ──────────────────────────────────────────────────────
# Supporting evidence only (weight 0); it never decides a verdict. ON by default locally, OFF in Docker.
# Set to 0 to skip it: saves a ~13 GB download and ~13 GB of RAM.
# AI_DETECTOR_TEXT_PAIR=0
# Base + Instruct models; both must share a tokenizer.
# AI_DETECTOR_TEXT_OBSERVER=mlx-community/Llama-3.2-3B-bf16
# AI_DETECTOR_TEXT_PERFORMER=mlx-community/Llama-3.2-3B-Instruct

# ── Paths ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Where models are downloaded (default: apps/detector/data/models). Hugging Face, torch, and
# AudioSeal caches are created under this directory. Nothing is written to ~/.cache.
# AI_DETECTOR_CACHE=
# ffmpeg binary for voice/video decoding. Default: ffmpeg on PATH, else the copy bundled with imageio-ffmpeg.
# FFMPEG=
