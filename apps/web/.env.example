# Sniff web app (local development). `pnpm bootstrap` copies this to .env. Never commit .env.
# Docker users: set PUBLIC_SERVER_URL in the root .env instead.

# Where browsers reach the API server. Inlined into the client bundle at build time, so restart `pnpm dev` or
# rebuild after changing it. Must match BETTER_AUTH_URL in apps/server/.env.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: the API URL the Next.js server uses for its own requests, when it differs from the public one
# (Docker sets http://server:3000). Default: NEXT_PUBLIC_SERVER_URL.
# SERVER_URL=
