{
  "name": "sniff",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @sniff/db --",
    "db:studio": "turbo run db:studio -F @sniff/db --",
    "db:generate": "turbo run db:generate -F @sniff/db --",
    "db:migrate": "turbo run db:migrate -F @sniff/db --",
    "deploy": "turbo run deploy -F @sniff/infra --",
    "destroy": "turbo run destroy -F @sniff/infra --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sniff/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
