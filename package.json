{
  "name": "sniff",
  "private": true,
  "description": "Is this AI? Check images, voice notes and text on the web or over WhatsApp.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "bootstrap": "sh scripts/bootstrap.sh",
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @sniff/db --",
    "db:migrate": "turbo run db:migrate -F @sniff/db --",
    "db:push": "turbo run db:push -F @sniff/db --",
    "db:studio": "turbo run db:studio -F @sniff/db --",
    "deploy": "turbo run deploy -F @sniff/infra --",
    "destroy": "turbo run destroy -F @sniff/infra --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "fix": "ultracite fix",
    "models": "cd apps/detector && uv run ai-detector-download",
    "test": "turbo run test"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@shadcn/lint": "^0.2.5",
    "@sniff/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "8.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
