# Optional settings for `docker compose up`. Copy to .env and fill in what you need; everything has a working default.

# Muse (Meta Model API) writes the friendly replies. Without it, replies use the detector's built-in template.
# Get a key at https://dev.meta.ai
MODEL_API_KEY=
# MUSE_MODEL=muse-wonder-1.0

# Text zero-shot pair (Binoculars / Fast-DetectGPT). Weight 0: supporting evidence only. 1 = download ~13 GB more
# and give Docker at least 16 GB of memory.
# AI_DETECTOR_TEXT_PAIR=0
# HF_TOKEN=            # only for gated models, e.g. AI_DETECTOR_TEXT_OBSERVER=meta-llama/Llama-3.1-8B

# Public URLs, when not running on localhost (e.g. behind a reverse proxy).
# PUBLIC_SERVER_URL=http://localhost:3000
# PUBLIC_WEB_URL=http://localhost:3001

# Auth secret (32+ chars). Leave empty to have one generated and kept in the data volume.
# BETTER_AUTH_SECRET=

# Comma-separated emails that may see WhatsApp checks in the web History.
# ADMIN_EMAILS=

# WhatsApp Cloud API (one number). Leave empty to disable. Webhook URL: <PUBLIC_SERVER_URL>/webhooks/whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
