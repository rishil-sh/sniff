# Sniff: settings for `docker compose up`.
# Copy to `.env` next to docker-compose.yml. Every value is optional: with an empty file, Sniff runs fully on localhost.
# Running without Docker? Use apps/server/.env, apps/web/.env and apps/detector/.env instead (`pnpm bootstrap`).
# Never commit `.env`.

# ── Friendly replies (Muse, Meta Model API) ───────────────────────────────────────────────────────────────────────
# What: API key for the model that turns a verdict into a plain-words reply and answers follow-up questions.
# Why:  Without it, verdicts are identical; replies just use the detector's built-in template text.
# Get:  https://dev.meta.ai → API keys.
MODEL_API_KEY=
# Which Muse model writes replies. Default: muse-wonder-1.0. muse-spark-1.3 is faster and cheaper.
# MUSE_MODEL=muse-wonder-1.0

# ── Text: zero-shot Llama pair (Binoculars / Fast-DetectGPT / GLTR) ───────────────────────────────────────────────
# What: 1 adds supporting text evidence from a Llama base + Instruct pair. It never decides a verdict (weight 0).
# Why:  Off by default because it downloads ~13 GB more and needs Docker memory ≥ 16 GB.
# AI_DETECTOR_TEXT_PAIR=0
# Swap the pair (both must share a tokenizer). Defaults are ungated, so no token is needed.
# AI_DETECTOR_TEXT_OBSERVER=mlx-community/Llama-3.2-3B-bf16
# AI_DETECTOR_TEXT_PERFORMER=mlx-community/Llama-3.2-3B-Instruct
# Hugging Face token, only for gated models such as meta-llama/Llama-3.1-8B. Get: https://huggingface.co/settings/tokens
# HF_TOKEN=

# ── Public URLs ───────────────────────────────────────────────────────────────────────────────────────────────────
# What: Where browsers reach the API and the web app. Change these when Sniff is not on localhost (domain, tunnel,
#       reverse proxy). PUBLIC_SERVER_URL is baked into the web build, so rebuild after changing it:
#       `docker compose up --build`.
# PUBLIC_SERVER_URL=http://localhost:3000
# PUBLIC_WEB_URL=http://localhost:3001
# Own domain over HTTPS (`docker compose --profile public up --build`): Caddy serves the web app at SNIFF_DOMAIN and
# the API at api.SNIFF_DOMAIN. Point both DNS names at this machine's public IP, with ports 80 and 443 reachable.
# SNIFF_DOMAIN=sniff.example.com
# PUBLIC_SERVER_URL=https://api.sniff.example.com
# PUBLIC_WEB_URL=https://sniff.example.com

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# What: Secret that signs login sessions (32+ characters).
# Why:  Leave empty and one is generated on first boot and kept in the `data` volume. Set it yourself only to share
#       sessions across machines. Generate: `openssl rand -base64 32`
# BETTER_AUTH_SECRET=
# Comma-separated emails allowed to see WhatsApp checks in the web History (WhatsApp users have no web login).
# ADMIN_EMAILS=you@example.com

# ── WhatsApp Cloud API (optional channel) ─────────────────────────────────────────────────────────────────────────
# Leave all four empty to disable WhatsApp. Setup steps: README.md → WhatsApp.
# Webhook URL to register in Meta: <PUBLIC_SERVER_URL>/webhooks/whatsapp (must be HTTPS).
# Meta app → WhatsApp → API Setup: a permanent System User token is best; the temporary one expires in 24 h.
# WHATSAPP_ACCESS_TOKEN=
# Meta app → WhatsApp → API Setup → "Phone number ID" (a number, not the phone number itself).
# WHATSAPP_PHONE_NUMBER_ID=
# Meta app → App settings → Basic → App secret. Used to verify that webhook calls really come from Meta.
# WHATSAPP_APP_SECRET=
# Any string you invent; type the same value into Meta's webhook form.
# WHATSAPP_VERIFY_TOKEN=
