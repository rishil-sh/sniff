{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "interactive": true
    },
    "destroy": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "cache": false
    }
  },
  "globalEnv": [
    "ADMIN_EMAILS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CI",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "DETECTOR_URL",
    "MASTRA_DATABASE_URL",
    "MIGRATIONS_DIR",
    "MODEL_API_KEY",
    "MUSE_MODEL",
    "NEXT_PUBLIC_SERVER_URL",
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_VERIFY_TOKEN"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
